<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">9.0.15</RuntimeFrameworkVersion>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)versions.conf')), '(?m)(?&lt;=^EDITOR_VERSION=)[0-9]+\.[0-9]+\.[0-9]+').Value)</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Editor\Assets\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <LudorkTargetPlatform>macOS</LudorkTargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <LudorkTargetPlatform>Windows</LudorkTargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LudorkTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
    <LudorkTargetPlatform>macOS</LudorkTargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LudorkTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">
    <LudorkTargetPlatform>Windows</LudorkTargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LudorkTargetPlatform)' == 'macOS'">
    <DefineConstants>$(DefineConstants);LUDORK_MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LudorkTargetPlatform)' == 'Windows'">
    <DefineConstants>$(DefineConstants);LUDORK_WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RuntimeIdentifier)' == '' and '$(OutputPath)' == '' and '$(OutDir)' == ''">
    <LudorkDevelopmentBundle>true</LudorkDevelopmentBundle>
    <UseAppHost>true</UseAppHost>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/$(TargetFramework)/Ludork.app/Contents/MacOS/</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <PublishDir Condition="'$(PublishDir)' == ''">bin/$(Configuration)/$(TargetFramework)/publish/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Editor\Controls\MacOSAnimationAudioPlayback.cs" Condition="'$(LudorkTargetPlatform)' != 'macOS'" />
    <Compile Remove="Editor\Controls\WindowsAnimationAudioPlayback.cs" Condition="'$(LudorkTargetPlatform)' != 'Windows'" />
    <Compile Remove="Editor\Ludork.Plugin.Abstractions\**\*.cs" />
    <Compile Remove="Editor\Ludork.Plugin.Avalonia\**\*.cs" />
    <Compile Remove="Plugins\**\*.cs" />
    <Compile Remove="Game\**\*.cs" />
    <Compile Remove="Templates\**\*.cs" />
    <None Include="Plugins\**\*.cs" />
    <AvaloniaResource Include="Editor\Assets\**" />
    <AvaloniaResource Include="Editor\EditorTutorial\Scenes\**\*.json" />
    <AvaloniaResource Include="Editor\EditorTutorial\Assets\**" />
    <EmbeddedResource Include="Editor\PluginTemplates\**\*" WithCulture="false" />
    <Content Include="Locale\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README_zh_CN.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Licenses\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Editor\Ludork.Plugin.Abstractions\Ludork.Plugin.Abstractions.csproj" />
    <ProjectReference Include="Editor\Ludork.Plugin.Avalonia\Ludork.Plugin.Avalonia.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Labs.Notifications" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" Condition="'$(LudorkTargetPlatform)' == 'Windows'" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NodifyM.Avalonia" Version="12.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <LudorkScriptTools>$(MSBuildProjectDirectory)/.tools/ScriptTools/ScriptTools</LudorkScriptTools>
    <LudorkScriptTools Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(LudorkScriptTools).exe</LudorkScriptTools>
  </PropertyGroup>

  <Target
      Name="IncludeMacOSNotificationLibrary"
      BeforeTargets="AssignTargetPaths"
      Condition="'$(LudorkTargetPlatform)' == 'macOS' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <LudorkMacOSNotificationRuntime>$(RuntimeIdentifier)</LudorkMacOSNotificationRuntime>
      <LudorkMacOSNotificationRuntime Condition="'$(LudorkMacOSNotificationRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</LudorkMacOSNotificationRuntime>
      <LudorkMacOSNotificationArchitecture Condition="'$(LudorkMacOSNotificationRuntime)' == 'osx-arm64'">arm64</LudorkMacOSNotificationArchitecture>
      <LudorkMacOSNotificationArchitecture Condition="'$(LudorkMacOSNotificationRuntime)' == 'osx-x64'">x86_64</LudorkMacOSNotificationArchitecture>
      <LudorkMacOSNotificationDirectory>$(IntermediateOutputPath)native/$(LudorkMacOSNotificationArchitecture)/</LudorkMacOSNotificationDirectory>
      <LudorkMacOSNotificationLibrary>$(LudorkMacOSNotificationDirectory)libLudorkNotifications.dylib</LudorkMacOSNotificationLibrary>
      <LudorkMacOSNotificationCompilerOptions>-O2</LudorkMacOSNotificationCompilerOptions>
      <LudorkMacOSNotificationCompilerOptions Condition="'$(Configuration)' == 'Debug'">-O0 -g</LudorkMacOSNotificationCompilerOptions>
    </PropertyGroup>
    <ItemGroup>
      <LudorkMacOSNotificationSource Include="Editor/Native/macOS/src/*.mm" />
      <LudorkMacOSNotificationHeader Include="Editor/Native/macOS/include/*.h;Editor/Native/macOS/src/*.hpp" />
      <Content Include="$(LudorkMacOSNotificationLibrary)"
          Link="libLudorkNotifications.dylib"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(LudorkMacOSNotificationLibrary)" />
    </ItemGroup>
  </Target>

  <Target
      Name="BuildMacOSNotificationLibrary"
      BeforeTargets="CoreCompile"
      DependsOnTargets="IncludeMacOSNotificationLibrary"
      Condition="'$(LudorkTargetPlatform)' == 'macOS' and '$(DesignTimeBuild)' != 'true'"
      Inputs="@(LudorkMacOSNotificationSource);@(LudorkMacOSNotificationHeader);$(MSBuildProjectFullPath)"
      Outputs="$(LudorkMacOSNotificationLibrary)">
    <Error Condition="!$([MSBuild]::IsOSPlatform('OSX'))" Text="The macOS notification library must be built on macOS." />
    <Error Condition="'$(LudorkMacOSNotificationArchitecture)' == ''" Text="Unsupported macOS notification architecture: $(LudorkMacOSNotificationRuntime)." />
    <MakeDir Directories="$(LudorkMacOSNotificationDirectory)" />
    <Exec Command="xcrun clang++ -std=c++17 -dynamiclib -fobjc-arc -fblocks -fno-rtti -fexceptions -arch $(LudorkMacOSNotificationArchitecture) -mmacosx-version-min=13.3 $(LudorkMacOSNotificationCompilerOptions) -framework Foundation -framework UserNotifications -I&quot;$(MSBuildProjectDirectory)/Editor/Native/macOS/include&quot; @(LudorkMacOSNotificationSource-&gt;'&quot;%(FullPath)&quot;', ' ') -Wl,-install_name,@rpath/libLudorkNotifications.dylib -o &quot;$(LudorkMacOSNotificationLibrary)&quot;" />
  </Target>

  <Target
      Name="ValidateEditorVersion"
      BeforeTargets="BeforeBuild;GetAssemblyVersion">
    <Error Condition="'$(Version)' == ''" Text="EDITOR_VERSION is not set in versions.conf." />
  </Target>

  <Target
      Name="GenerateEditorBuildMetadata"
      DependsOnTargets="GenerateEngineConstants">
    <PropertyGroup>
      <LudorkBuildInfoArgument Condition="'$(LudorkBuildInfo)' != ''">--build-info &quot;$(LudorkBuildInfo)&quot;</LudorkBuildInfoArgument>
    </PropertyGroup>
    <Exec Command="&quot;$(LudorkScriptTools)&quot; editor-build-metadata csharp &quot;$(MSBuildProjectDirectory)/versions.conf&quot; &quot;$(IntermediateOutputPath)EditorBuildMetadata.g.cs&quot; --version &quot;$(Version)&quot; $(LudorkBuildInfoArgument)" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)EditorBuildMetadata.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="IncludeEditorBuildMetadata"
      BeforeTargets="BeforeCompile"
      DependsOnTargets="GenerateEditorBuildMetadata">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)EditorBuildMetadata.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="GenerateEngineConstants"
      Inputs="$(MSBuildProjectDirectory)/Game/Engine/Source/Core/include/EngineState.hpp;$(MSBuildProjectDirectory)/ScriptTools/engine_constants.py;$(MSBuildProjectFullPath)"
      Outputs="$(IntermediateOutputPath)EngineConstants.g.cs">
    <Error Condition="!Exists('$(LudorkScriptTools)')" Text="ScriptTools was not found. Run tools/init for this platform first." />
    <Exec Command="&quot;$(LudorkScriptTools)&quot; engine-constants &quot;$(MSBuildProjectDirectory)/Game/Engine/Source/Core/include/EngineState.hpp&quot; &quot;$(IntermediateOutputPath)EngineConstants.g.cs&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)EngineConstants.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="IncludeEngineConstants"
      BeforeTargets="BeforeCompile"
      DependsOnTargets="GenerateEngineConstants">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)EngineConstants.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="GenerateProjectToolConstants"
      DependsOnTargets="GenerateEngineConstants"
      Inputs="$(MSBuildProjectDirectory)/ScriptTools/packaging_constants.py;$(MSBuildProjectDirectory)/ScriptTools/packaging_cli.py;$(MSBuildProjectFullPath)"
      Outputs="$(IntermediateOutputPath)ProjectToolConstants.g.cs">
    <Exec Command="&quot;$(LudorkScriptTools)&quot; packaging-constants csharp &quot;$(IntermediateOutputPath)ProjectToolConstants.g.cs&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)ProjectToolConstants.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="IncludeProjectToolConstants"
      BeforeTargets="BeforeCompile"
      DependsOnTargets="GenerateProjectToolConstants">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ProjectToolConstants.g.cs" />
    </ItemGroup>
  </Target>

  <Target
      Name="CleanPublicDocumentationOutput"
      BeforeTargets="GetCopyToOutputDirectoryItems"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(TargetDir)docs;$(TargetDir)Page" />
    <ItemGroup>
      <StaleDocumentationOutput Include="$(TargetDir)About_*.md;$(TargetDir)THIRD_PARTY_NOTICES*.md" />
    </ItemGroup>
    <Delete Files="@(StaleDocumentationOutput)" />
  </Target>

  <Target
      Name="CleanPublicDocumentationPublishOutput"
      BeforeTargets="ComputeFilesToPublish"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(PublishDir)docs;$(PublishDir)Page" />
    <ItemGroup>
      <StaleDocumentationPublishOutput Include="$(PublishDir)About_*.md;$(PublishDir)THIRD_PARTY_NOTICES*.md" />
    </ItemGroup>
    <Delete Files="@(StaleDocumentationPublishOutput)" />
  </Target>

  <Target
      Name="WriteLegalResourceOutput"
      AfterTargets="Build"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(LudorkScriptTools)&quot; legal-resources editor &quot;$(MSBuildProjectDirectory)&quot; &quot;$(TargetDir)/.&quot;" />
  </Target>

  <Target
      Name="WriteLegalResourcePublishOutput"
      AfterTargets="Publish"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(LudorkScriptTools)&quot; legal-resources editor &quot;$(MSBuildProjectDirectory)&quot; &quot;$(PublishDir)/.&quot;" />
  </Target>

  <Target
      Name="WriteLudorkDevelopmentPluginMarker"
      AfterTargets="Build"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <WriteLinesToFile
        File="$(TargetDir).ludork-development"
        Lines="$(MSBuildProjectDirectory)"
        Overwrite="true"
        Encoding="UTF-8" />
  </Target>

  <Target
      Name="RemoveLudorkDevelopmentPluginMarkerFromPublish"
      AfterTargets="Publish">
    <Delete Files="$(PublishDir).ludork-development" />
  </Target>

  <Target
      Name="PrepareLudorkDevelopmentBundle"
      AfterTargets="Build"
      DependsOnTargets="WriteLegalResourceOutput;WriteLudorkDevelopmentPluginMarker"
      Condition="'$(LudorkDevelopmentBundle)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/tools/editor_macos_development/prepare.sh&quot; &quot;$(TargetDir)&quot; &quot;$(Version)&quot; &quot;$(MSBuildProjectDirectory)/Editor/Assets/icon.png&quot; &quot;$(IntermediateOutputPath)&quot; &quot;$(LudorkScriptTools)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)../Info.plist;$(TargetDir)../Resources/AppIcon.icns;$(TargetDir)../_CodeSignature/CodeResources" />
    </ItemGroup>
  </Target>
</Project>
