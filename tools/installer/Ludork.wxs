<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Ludork"
      Manufacturer="Ludork"
      Version="$(ProductVersion)"
      UpgradeCode="7D581A67-D171-4ECB-A6F8-E62D9512E234"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">
    <SummaryInformation Description="Ludork Editor" Manufacturer="Ludork" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Ludork is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="LudorkProjectIcon" SourceFile="!(bindpath.assets)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LudorkProjectIcon" />
    <CustomAction
        Id="NotifyShellAssociationChangedOnInstall"
        FileRef="LudorkExe"
        ExeCommand="--notify-shell-association-changed"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />
    <CustomAction
        Id="NotifyShellAssociationChangedOnUninstall"
        FileRef="LudorkExe"
        ExeCommand="--notify-shell-association-changed"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />
    <InstallExecuteSequence>
      <Custom
          Action="NotifyShellAssociationChangedOnUninstall"
          After="RemoveRegistryValues"
          Condition="REMOVE ~= &quot;ALL&quot;" />
      <Custom
          Action="NotifyShellAssociationChangedOnInstall"
          After="WriteRegistryValues"
          Condition="NOT Installed" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Ludork" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Complete" Title="Ludork" Level="1">
      <ComponentGroupRef Id="EditorFiles" />
      <ComponentRef Id="ProjectAssociation" />
    </Feature>
  </Package>

  <Fragment>
    <Component
        Id="ProjectAssociation"
        Directory="INSTALLFOLDER"
        Guid="055148B9-7369-5E31-934A-0EA040CA99D3">
      <RegistryValue
          Root="HKCU"
          Key="Software\Ludork\Installer\Components"
          Name="ProjectAssociation"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      <RemoveRegistryKey
          Id="RemoveInstallerRegistry"
          Root="HKCU"
          Key="Software\Ludork\Installer"
          Action="removeOnUninstall" />
      <RemoveRegistryKey
          Id="RemoveProjectProgId"
          Root="HKCU"
          Key="Software\Classes\Ludork.Project"
          Action="removeOnUninstall" />
      <File Id="LudorkExe" Source="!(bindpath.dist)\Ludork.exe">
        <Shortcut
            Id="DesktopShortcut"
            Directory="DesktopFolder"
            Name="Ludork"
            Description="Ludork Editor"
            WorkingDirectory="INSTALLFOLDER" />
      </File>
      <File
          Id="LudorkProjectFileIcon"
          Source="!(bindpath.assets)\project-icon.ico"
          Name="LudorkProject.ico" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\.proj"
          Type="string"
          Value="Ludork.Project" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\Ludork.Project"
          Type="string"
          Value="Ludork Project" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\Ludork.Project\DefaultIcon"
          Type="string"
          Value="[INSTALLFOLDER]LudorkProject.ico,0" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\Ludork.Project\shell\open"
          Type="string"
          Value="Open" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Classes\Ludork.Project\shell\open\command"
          Type="string"
          Value="&quot;[INSTALLFOLDER]Ludork.exe&quot; &quot;%1&quot;" />
    </Component>
  </Fragment>
</Wix>
