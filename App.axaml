<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ludork.App"
             xmlns:local="using:Ludork"
             xmlns:material="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             Name="Ludork"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="LudorkPrimaryBrush" Color="#ffd740" />
        <SolidColorBrush x:Key="LudorkPrimaryMutedBrush" Color="#33ffd740" />
        <SolidColorBrush x:Key="LudorkSurfaceBrush" Color="#232629" />
        <SolidColorBrush x:Key="LudorkTextBrush" Color="#ffffff" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Ludork"
                            Click="onOpenAbout" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <material:MaterialTheme BaseTheme="Dark"
                                PrimaryColor="Amber"
                                SecondaryColor="Lime" />
        <StyleInclude Source="avares://Ludork/Styles/NativeMenuItems.axaml" />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <Style Selector="NumericUpDown.ludork-editable /template/ Border#PART_RootBorder">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="NumericUpDown.ludork-editable /template/ TextBox#PART_TextBox">
            <Setter Property="Margin" Value="{Binding $parent[NumericUpDown].Padding}" />
        </Style>
    </Application.Styles>
</Application>
