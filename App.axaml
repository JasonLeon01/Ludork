<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ludork.App"
             xmlns:local="using:Ludork"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             Name="Ludork"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Ludork/Editor/Resources/EditorIcons.axaml" />
                <ResourceInclude Source="avares://Ludork/Editor/Resources/EditorTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Ludork"
                            Click="onOpenAbout" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <fluent:FluentTheme DensityStyle="Compact">
            <fluent:FluentTheme.Palettes>
                <fluent:ColorPaletteResources x:Key="Dark"
                                             Accent="{StaticResource Editor.AccentColor}"
                                             RegionColor="{StaticResource Editor.BackgroundColor}"
                                             BaseHigh="{StaticResource Editor.TextColor}"
                                             BaseMedium="{StaticResource Editor.TextMutedColor}"
                                             ChromeLow="{StaticResource Editor.SurfaceColor}"
                                             ChromeMediumLow="{StaticResource Editor.SurfaceColor}"
                                             ChromeHigh="{StaticResource Editor.InputColor}"
                                             ErrorText="{StaticResource Editor.ErrorColor}" />
            </fluent:FluentTheme.Palettes>
        </fluent:FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <StyleInclude Source="avares://Ludork/Editor/Styles/EditorControls.axaml" />
        <StyleInclude Source="avares://Ludork/Editor/Styles/NativeMenuItems.axaml" />
    </Application.Styles>
</Application>
