<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Ludork.OfficialRandomMap</AssemblyName>
    <RootNamespace>Ludork.Plugins.OfficialRandomMap</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ludork.Plugin.Abstractions\Ludork.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\Ludork.Plugin.Avalonia\Ludork.Plugin.Avalonia.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="Avalonia" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="locales\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
