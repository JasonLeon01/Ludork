include_guard(GLOBAL)

set(LUDORK_TOOLCHAIN_DIRECTORY "" CACHE PATH "Directory containing the Ludork toolchain runtime")
if(NOT IS_DIRECTORY "${LUDORK_TOOLCHAIN_DIRECTORY}")
    message(FATAL_ERROR "LUDORK_TOOLCHAIN_DIRECTORY is missing. Run tools/init first.")
endif()

function(ludork_get_tool output_variable role)
    if(NOT role MATCHES "^(build|codegen|assets|pack|editor|check)$")
        message(FATAL_ERROR "Unknown Ludork toolchain role: ${role}")
    endif()
    set(executable "${LUDORK_TOOLCHAIN_DIRECTORY}/ludork-${role}")
    if(CMAKE_HOST_WIN32)
        string(APPEND executable ".exe")
    endif()
    if(NOT EXISTS "${executable}")
        message(FATAL_ERROR "Ludork toolchain executable is missing: ${executable}")
    endif()
    set(${output_variable} "${executable}" PARENT_SCOPE)
endfunction()

function(ludork_get_toolchain_dependencies output_variable)
    get_filename_component(toolchain_directory "${LUDORK_TOOLCHAIN_DIRECTORY}" ABSOLUTE)
    string(SHA256 bundle_key "${toolchain_directory}")
    set(dependencies_property "LUDORK_TOOLCHAIN_DEPENDENCIES_${bundle_key}")
    get_property(dependencies_are_set GLOBAL PROPERTY "${dependencies_property}" SET)
    if(NOT dependencies_are_set)
        file(GLOB_RECURSE dependencies LIST_DIRECTORIES false CONFIGURE_DEPENDS
            "${toolchain_directory}/*")
        set_property(GLOBAL PROPERTY "${dependencies_property}" "${dependencies}")
    endif()
    get_property(dependencies GLOBAL PROPERTY "${dependencies_property}")
    set(${output_variable} "${dependencies}" PARENT_SCOPE)
endfunction()
