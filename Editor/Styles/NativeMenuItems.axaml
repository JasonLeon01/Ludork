<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
        xmlns:ripple="clr-namespace:Material.Ripple;assembly=Material.Ripple"
        xmlns:system="clr-namespace:System;assembly=netstandard">
    <Styles.Resources>
        <converters:PlatformKeyGestureConverter x:Key="LudorkMenuKeyGestureConverter" />

        <ControlTheme x:Key="LudorkNativeSubmenuItem"
                      TargetType="MenuItem"
                      BasedOn="{StaticResource MaterialMenuItem}">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_MenuItemRootBorder"
                            Height="{TemplateBinding Height}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Panel>
                            <Border Name="PART_MenuItemHighlighter"
                                    Background="{DynamicResource MaterialBodyBrush}" />
                            <ripple:RippleEffect Name="PART_Ripple"
                                                 RippleFill="{DynamicResource MaterialFlatButtonRippleBrush}">
                                <Grid Margin="{TemplateBinding Padding}"
                                      ColumnDefinitions="40,*,Auto,Auto,20">
                                    <CheckBox Name="PART_CheckBoxIndicator"
                                              Grid.Column="0"
                                              Width="24"
                                              Height="24"
                                              Padding="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              IsHitTestVisible="False"
                                              IsChecked="{TemplateBinding IsChecked}"
                                              IsVisible="False"
                                              assists:SelectionControlAssist.Size="20" />
                                    <RadioButton Name="PART_RadioIndicator"
                                                 Grid.Column="0"
                                                 Width="24"
                                                 Height="24"
                                                 Padding="0"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Focusable="False"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{TemplateBinding IsChecked}"
                                                 IsVisible="False"
                                                 assists:SelectionControlAssist.Size="20" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ContentPresenter Name="PART_Icon"
                                                          Width="24"
                                                          Height="24"
                                                          Margin="0,0,16,0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                          Content="{TemplateBinding Icon}" />
                                        <ContentPresenter Name="PART_HeaderPresenter"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}">
                                            <ContentPresenter.DataTemplates>
                                                <DataTemplate DataType="system:String">
                                                    <AccessText Text="{Binding}"
                                                                Theme="{StaticResource MaterialMenuItemStringAccessText}" />
                                                </DataTemplate>
                                            </ContentPresenter.DataTemplates>
                                        </ContentPresenter>
                                    </StackPanel>

                                    <TextBlock Name="PART_InputGestureText"
                                               Grid.Column="2"
                                               Margin="24,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding InputGesture, Converter={StaticResource LudorkMenuKeyGestureConverter}}" />

                                    <Path Name="PART_RightArrow"
                                          Grid.Column="3"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="{StaticResource EditorIcon.SubmenuRight}" />

                                    <Popup Name="PART_Popup"
                                           Grid.Column="0"
                                           Placement="Right"
                                           IsLightDismissEnabled="False"
                                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                                        <controls:Card Padding="0">
                                            <Border Name="PART_MainBorder"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer>
                                                    <ItemsPresenter Name="PART_ItemsPresenter"
                                                                    Margin="0,8"
                                                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </ScrollViewer>
                                            </Border>
                                        </controls:Card>
                                    </Popup>
                                </Grid>
                            </ripple:RippleEffect>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:toggle /template/ CheckBox#PART_CheckBoxIndicator">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:radio /template/ RadioButton#PART_RadioIndicator">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="NativeMenuBar MenuItem">
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource LudorkNativeSubmenuItem}" />
    </Style>
</Styles>
