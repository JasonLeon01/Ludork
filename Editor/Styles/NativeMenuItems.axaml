<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="LudorkNativeSubmenuItem"
                      TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="NativeMenuBar">
        <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
    </Style>
    <Style Selector="NativeMenuBar MenuItem">
        <Setter Property="ItemContainerTheme" Value="{StaticResource LudorkNativeSubmenuItem}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</Styles>
