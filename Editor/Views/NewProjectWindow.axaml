<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.NewProjectWindow"
        Width="980" Height="780" MinWidth="880" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico"
        Closing="onClosing"
        Title="New Project">
    <Window.Styles>
        <Style Selector="ToggleButton.templateCard">
            <Setter Property="MinHeight" Value="146" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ToggleButton.templateCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
        </Style>
        <Style Selector="ToggleButton.templateCard:checked">
            <Setter Property="Background" Value="{DynamicResource Editor.AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
        </Style>
        <Style Selector="Border.templateIcon">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
        </Style>
        <Style Selector="TextBlock.badgeText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.TextBrush}" />
        </Style>
        <Style Selector="TextBlock.sectionCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.TextMutedBrush}" />
        </Style>
        <Style Selector="Button.footerButton">
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="20,0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Margin="24,16,24,0"
                   Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
        <Grid x:Name="TemplateAndDetails" Grid.Row="1" Margin="24,16,24,16"
              ColumnDefinitions="310,*" ColumnSpacing="20">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock x:Name="ChooseTemplateText" Classes="sectionCaption" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <UniformGrid Columns="1" RowSpacing="12" Margin="0,0,5,0">
                    <ToggleButton x:Name="StandaloneTemplateButton" Classes="templateCard"
                                  IsChecked="True" Click="onStandaloneTemplateClick">
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="15">
                            <Border Classes="templateIcon">
                                <Viewbox Width="36" Height="36">
                                    <Canvas Width="40" Height="40">
                                        <Path Data="{StaticResource EditorIcon.TemplateStandaloneFrame}"
                                              Stroke="{DynamicResource Editor.TextBrush}" StrokeThickness="2" />
                                        <Path Data="{StaticResource EditorIcon.TemplateStandalonePlay}"
                                              Fill="{DynamicResource Editor.AccentBrush}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock x:Name="StandaloneTitle" FontSize="16"
                                           FontWeight="Bold" Foreground="{DynamicResource Editor.TextBrush}" />
                                <WrapPanel>
                                    <Border Classes="badge" Background="{DynamicResource Editor.StandaloneBadgeBrush}">
                                        <TextBlock x:Name="StandaloneBadge" Classes="badgeText" Foreground="{DynamicResource Editor.StandaloneBadgeTextBrush}" />
                                    </Border>
                                    <Border Classes="badge" Margin="6,0,0,0">
                                        <TextBlock x:Name="StandaloneNoCompilerBadge" Classes="badgeText" />
                                    </Border>
                                    <Border Classes="badge" Margin="6,0,0,0">
                                        <TextBlock x:Name="StandaloneReadyBadge" Classes="badgeText" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="StandaloneSummary" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="CppTemplateButton" Classes="templateCard"
                                  Click="onCppTemplateClick">
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="15">
                            <Border Classes="templateIcon">
                                <Viewbox Width="42" Height="30">
                                    <Canvas Width="48" Height="34">
                                        <Path Data="{StaticResource EditorIcon.TemplateCppCode}"
                                              Stroke="{DynamicResource Editor.TextBrush}" StrokeThickness="3" />
                                        <Path Data="{StaticResource EditorIcon.TemplateCppSlash}"
                                              Stroke="{DynamicResource Editor.AccentBrush}" StrokeThickness="3" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock x:Name="CppTitle" FontSize="16"
                                           FontWeight="Bold" Foreground="{DynamicResource Editor.TextBrush}" />
                                <WrapPanel>
                                    <Border Classes="badge" Background="{DynamicResource Editor.SourceBadgeBrush}">
                                        <TextBlock x:Name="CppBadge" Classes="badgeText" Foreground="{DynamicResource Editor.SourceBadgeTextBrush}" />
                                    </Border>
                                    <Border Classes="badge" Margin="6,0,0,0">
                                        <TextBlock x:Name="CppSourceBadge" Classes="badgeText" />
                                    </Border>
                                    <Border Classes="badge" Margin="6,0,0,0">
                                        <TextBlock x:Name="CppDebugBadge" Classes="badgeText" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="CppSummary" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                </UniformGrid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource Editor.BackgroundBrush}" BorderBrush="{DynamicResource Editor.BorderBrush}"
                    BorderThickness="1,0,0,0" Padding="24,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <Grid ColumnDefinitions="86,*" ColumnSpacing="20">
                        <Border Width="86" Height="86" CornerRadius="18" Background="{DynamicResource Editor.SurfaceBrush}">
                            <Grid>
                                <Viewbox x:Name="StandaloneHeroIcon" Width="54" Height="54">
                                    <Canvas Width="40" Height="40">
                                        <Path Data="{StaticResource EditorIcon.TemplateStandaloneFrame}"
                                              Stroke="{DynamicResource Editor.TextBrush}" StrokeThickness="2" />
                                        <Path Data="{StaticResource EditorIcon.TemplateStandalonePlay}"
                                              Fill="{DynamicResource Editor.AccentBrush}" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="CppHeroIcon" Width="62" Height="48" IsVisible="False">
                                    <Canvas Width="48" Height="34">
                                        <Path Data="{StaticResource EditorIcon.TemplateCppCode}"
                                              Stroke="{DynamicResource Editor.TextBrush}" StrokeThickness="3" />
                                        <Path Data="{StaticResource EditorIcon.TemplateCppSlash}"
                                              Stroke="{DynamicResource Editor.AccentBrush}" StrokeThickness="3" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Editor.TextBrush}" />
                            <WrapPanel>
                                <Border Classes="badge">
                                    <TextBlock x:Name="DetailPrimaryBadge" Classes="badgeText" />
                                </Border>
                                <Border Classes="badge" Margin="8,0,0,0">
                                    <TextBlock x:Name="DetailSecondaryBadge" Classes="badgeText" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="15">
                            <TextBlock x:Name="DetailDescription" FontSize="14" Foreground="{DynamicResource Editor.TextMutedBrush}"
                                       TextWrapping="Wrap" LineHeight="22" />
                            <TextBlock x:Name="FeaturesTitle" Classes="sectionCaption" />
                            <TextBlock x:Name="DetailFeature1" Foreground="{DynamicResource Editor.TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailFeature2" Foreground="{DynamicResource Editor.TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailFeature3" Foreground="{DynamicResource Editor.TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="RequirementsTitle" Classes="sectionCaption" Margin="0,5,0,0" />
                            <TextBlock x:Name="DetailRequirement1" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailRequirement2" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailRequirement3" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="CompatibilityPanel"
                            Grid.Row="2"
                            Background="{DynamicResource Editor.SurfaceBrush}"
                            CornerRadius="4"
                            Padding="13,10"
                            IsVisible="False">
                        <TextBlock x:Name="CompatibilityText" Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="ProjectSettingsPanel" Grid.Row="2" Background="{DynamicResource Editor.BackgroundBrush}"
                BorderBrush="{DynamicResource Editor.BorderBrush}" BorderThickness="0,1,0,0" Padding="28,18">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ProjectSettingsTitle" FontSize="14"
                           FontWeight="Bold" Foreground="{DynamicResource Editor.TextBrush}" />
                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LocationLabel" Classes="sectionCaption" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ProjectLocationBox" />
                            <Button x:Name="BrowseButton" Grid.Column="1"
                                    MinWidth="92" Click="onBrowse" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="NameLabel" Classes="sectionCaption" />
                        <TextBox x:Name="ProjectNameBox" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <TextBlock x:Name="FinalPathCaption" Foreground="{DynamicResource Editor.TextMutedBrush}" />
                    <TextBlock x:Name="FinalPathText" Grid.Column="1"
                               Foreground="{DynamicResource Editor.TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border Background="{DynamicResource Editor.SurfaceBrush}" BorderBrush="{DynamicResource Editor.BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="13,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="FfmpegTitle" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Editor.TextBrush}" />
                            <TextBlock x:Name="FfmpegSummary" FontSize="12"
                                       Foreground="{DynamicResource Editor.TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FfmpegToggle" Grid.Column="1"
                                      VerticalAlignment="Center" IsChecked="False" />
                    </Grid>
                </Border>
                <TextBlock x:Name="ValidationText" MinHeight="18"
                           Foreground="{DynamicResource Editor.ErrorBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource Editor.BackgroundBrush}" BorderBrush="{DynamicResource Editor.BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Editor.TextMutedBrush}" IsVisible="False" />
                    <ProgressBar x:Name="CopyProgress" Width="260" Height="4"
                                 HorizontalAlignment="Left" IsIndeterminate="True" IsVisible="False" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1"
                        Classes="footerButton" Click="onCancel" />
                <Button x:Name="CreateButton" Grid.Column="2" Classes="footerButton accent"
                        Background="{DynamicResource Editor.AccentBrush}" Foreground="{DynamicResource Editor.TextOnAccentBrush}"
                        FontWeight="Bold" Click="onCreate" />
            </Grid>
        </Border>
    </Grid>
</Window>
