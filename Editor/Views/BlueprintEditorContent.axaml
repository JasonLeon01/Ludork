<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ludork.ViewModels"
        xmlns:controls="using:Ludork.Controls"
        xmlns:utils="using:Ludork.Views.Utils"
        x:Class="Ludork.Views.BlueprintEditorContent"
        x:DataType="vm:BlueprintEditorViewModel">
    <Grid x:Name="EditorLayout" ColumnDefinitions="Auto,5,*">
        <Border Background="{DynamicResource Editor.SurfaceBrush}">
            <utils:ContentWidthScrollViewer x:Name="AttributeScroll"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" Spacing="8">
                    <Grid ColumnDefinitions="Auto,8,*,4,28">
                        <TextBlock x:Name="ParentLabel" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="ParentField" Grid.Column="2" />
                        <Button x:Name="ParentPicker" Grid.Column="4" Width="28" Padding="0"
                                IsVisible="{Binding CanEditAttributes}" IsEnabled="{Binding CanEditAttributes}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource EditorIcon.Ellipsis}"
                                      Fill="{DynamicResource Editor.TextBrush}" />
                            </Viewbox>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Editor.BorderSubtleBrush}" />
                    <controls:BlueprintVariableForm x:Name="VariableForm" />
                    <Button x:Name="AddAttributeButton" Content="+" HorizontalAlignment="Stretch"
                            IsVisible="{Binding CanEditAttributes}" />
                </StackPanel>
            </utils:ContentWidthScrollViewer>
        </Border>
        <GridSplitter x:Name="ContentSplitter" Grid.Column="1" Width="5"
                      VerticalAlignment="Stretch" ResizeDirection="Columns" />
        <Grid x:Name="RightPanel" Grid.Column="2" RowDefinitions="36,*">
            <Border Grid.Row="0" Classes="editor-panel-header">
                <Grid Height="36" ColumnDefinitions="*,Auto">
                    <ListBox x:Name="GraphList" Height="36" ClipToBounds="True" SelectionMode="Single"
                             Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button x:Name="ValidateButton" Grid.Column="1" Height="28" Margin="8,0" Padding="14,0" VerticalAlignment="Center" IsVisible="{Binding IsBlueprint}" />
                </Grid>
            </Border>
            <Grid x:Name="ContentHost" Grid.Row="1">
                <Grid x:Name="PreviewPanel" Background="{DynamicResource Editor.CanvasBrush}" IsVisible="False">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="PreviewPlaceholder" Foreground="{DynamicResource Editor.TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
