<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.TextConfigCreationDialog"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid RowDefinitions="*,Auto">
        <Grid Margin="24,20" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock x:Name="TypeLabel"
                       Grid.Row="0"
                       Foreground="{DynamicResource Editor.TextMutedBrush}" />
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="24">
                <RadioButton x:Name="PlainOption"
                             GroupName="TextConfigType"
                             IsChecked="True" />
                <RadioButton x:Name="RichOption"
                             GroupName="TextConfigType" />
            </StackPanel>
            <TextBlock x:Name="PathLabel"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Editor.TextMutedBrush}" />
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <TextBox x:Name="PathBox"
                         Grid.Column="0" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Width="32"
                        Padding="0"
                        Click="onBrowse">
                    <Viewbox Width="14" Height="14">
                        <Path Data="{StaticResource EditorIcon.Ellipsis}"
                              Fill="{DynamicResource Editor.TextBrush}" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Classes="editor-panel-footer" Padding="20,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        Classes="dialog"
                        Click="onCancel" />
                <Button x:Name="ConfirmButton"
                        Classes="dialog accent"
                        Click="onConfirm" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
