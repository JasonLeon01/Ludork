<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="Ludork.Views.PackLogDialog"
        Width="800"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="0"
                Margin="16"
                Background="{DynamicResource Editor.CanvasBrush}"
                BorderBrush="{DynamicResource Editor.BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Editor.RadiusMd}"
                ClipToBounds="True">
            <avaloniaEdit:TextEditor x:Name="LogArea"
                                     IsReadOnly="True"
                                     WordWrap="False"
                                     ShowLineNumbers="False"
                                     Background="{DynamicResource Editor.CanvasBrush}"
                                     Foreground="{DynamicResource Editor.TextBrush}"
                                     FontFamily="{DynamicResource Editor.MonoFontFamily}"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
        </Border>
        <Border Grid.Row="1" Classes="editor-panel-footer" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <ProgressBar x:Name="OperationProgress" Height="6" IsIndeterminate="True"
                             VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Classes="dialog"
                        HorizontalAlignment="Right"
                        IsEnabled="False"
                        Click="onClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
