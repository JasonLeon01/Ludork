<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ludork.ViewModels"
        xmlns:controls="using:Ludork.Controls"
        xmlns:views="using:Ludork.Views"
        xmlns:utils="using:Ludork.Views.Utils"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1512"
        d:DesignHeight="982"
        x:Class="Ludork.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        MinWidth="1144"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico"
        Title="Ludork">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{Binding File}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding NewProject}" Command="{Binding NewProjectCommand}" Gesture="{OnPlatform Default=Ctrl+N, macOS=Meta+N}" />
                    <NativeMenuItem Header="{Binding OpenProject}" Command="{Binding OpenProjectCommand}" Gesture="{OnPlatform Default=Ctrl+O, macOS=Meta+O}" />
                    <NativeMenuItem Header="{Binding Save}" Command="{Binding SaveCommand}" Gesture="{OnPlatform Default=Ctrl+S, macOS=Meta+S}" />
                    <NativeMenuItem Header="{Binding PackProject}" IsEnabled="{Binding CanEdit}" Click="onPackProject" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{Binding Exit}" Command="{Binding ExitCommand}" Gesture="{OnPlatform Default=Ctrl+W, macOS=Meta+W}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{Binding Edit}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding DevelopmentToolsSettings}">
                        <NativeMenu>
                            <NativeMenuItem Header="{Binding IndividualWindowLabel}"
                                            ToggleType="CheckBox"
                                            IsChecked="{Binding IndividualWindow, Mode=OneWay}"
                                            IsEnabled="{Binding CanConfigureIndividualWindow}"
                                            Click="onIndividualWindowClicked" />
                            <NativeMenuItem Header="{Binding MapWorkspace.LiveDebugLabel}"
                                            ToggleType="CheckBox"
                                            IsChecked="{Binding MapWorkspace.LiveDebug, Mode=OneWay}"
                                            IsEnabled="{Binding MapWorkspace.CanConfigureLiveDebug}"
                                            Click="onLiveDebugClicked" />
                            <NativeMenuItem Header="{Binding PerformanceMonitor}" Click="onOpenPerformanceMonitor" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{Binding Undo}" Command="{Binding UndoCommand}" Gesture="{OnPlatform Default=Ctrl+Z, macOS=Meta+Z}" />
                    <NativeMenuItem Header="{Binding Redo}" Command="{Binding RedoCommand}" Gesture="{OnPlatform Default=Ctrl+Y, macOS=Meta+Y}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{Binding Game}" IsEnabled="{Binding CanEdit}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding GameConfigLabel}" Command="{Binding GameConfigCommand}" Gesture="F3" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{Binding NewBlueprint}" Command="{Binding NewBlueprintCommand}" />
                    <NativeMenuItem Header="{Binding NewAnimation}" Command="{Binding NewAnimationCommand}" />
                    <NativeMenuItem Header="{Binding NewParticle}" Command="{Binding NewParticleCommand}" />
                    <NativeMenuItem Header="{Binding NewCurve}" Command="{Binding NewCurveCommand}" />
                    <NativeMenuItem Header="{Binding NewTextConfig}" Command="{Binding NewTextConfigCommand}" />
                    <NativeMenuItem Header="{Binding NewUiAsset}" Command="{Binding NewUiAssetCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{Binding Database}" IsEnabled="{Binding CanEdit}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding SystemConfig}" Command="{Binding SystemConfigCommand}" Gesture="F4" />
                    <NativeMenuItem Header="{Binding AnimationOverview}" Command="{Binding AnimationOverviewCommand}" Gesture="F5" />
                    <NativeMenuItem Header="{Binding ParticleOverview}" Command="{Binding ParticleOverviewCommand}" Gesture="F6" />
                    <NativeMenuItem Header="{Binding TilesetsData}" Command="{Binding TilesetsDataCommand}" Gesture="F7" />
                    <NativeMenuItem Header="{Binding CommonFunctions}" Command="{Binding CommonFunctionsCommand}" Gesture="F8" />
                    <NativeMenuItem Header="{Binding GameVariablesLabel}" Command="{Binding GameVariablesCommand}" Gesture="F9" />
                    <NativeMenuItem Header="{Binding GeneralData}" Command="{Binding GeneralDataCommand}" Gesture="F10" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{Binding Plugins}" IsEnabled="{Binding CanEdit}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding ImportPlugin}" Click="onImportPlugin" />
                    <NativeMenuItem Header="{Binding ManagePlugins}" Click="onManagePlugins" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{Binding Help}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding HelpExplanation}" Command="{Binding HelpCommand}" Gesture="F1" />
                    <NativeMenuItem Header="{Binding HelpLanguage}">
                        <NativeMenu>
                            <NativeMenuItem Header="en__GB"
                                            ToggleType="Radio"
                                            IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}"
                                            Command="{Binding ChangeLanguageCommand}"
                                            CommandParameter="en_GB" />
                            <NativeMenuItem Header="zh__CN"
                                            ToggleType="Radio"
                                            IsChecked="{Binding IsChineseLanguage, Mode=OneWay}"
                                            Command="{Binding ChangeLanguageCommand}"
                                            CommandParameter="zh_CN" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{Binding About}"
                                    IsVisible="{OnPlatform Default=True, macOS=False}"
                                    Click="onOpenAbout" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+S, macOS=Meta+S}" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+Z, macOS=Meta+Z}" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+Y, macOS=Meta+Y}" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+N, macOS=Meta+N}" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+O, macOS=Meta+O}" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+W, macOS=Meta+W}" Command="{Binding ExitCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+1, macOS=Meta+1}" Command="{Binding TileModeCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+2, macOS=Meta+2}" Command="{Binding LightModeCommand}" />
        <KeyBinding Gesture="{OnPlatform Default=Ctrl+3, macOS=Meta+3}" Command="{Binding ActorModeCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding HelpCommand}" />
        <KeyBinding Gesture="F3" Command="{Binding GameConfigCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding SystemConfigCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding AnimationOverviewCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding ParticleOverviewCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding TilesetsDataCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding CommonFunctionsCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding GameVariablesCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding GeneralDataCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="{DynamicResource Editor.BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.mode">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.mode:checked">
            <Setter Property="Background" Value="{DynamicResource Editor.AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,2,0" />
        </Style>
        <Style Selector="ToggleButton.layerVisibility > Image">
            <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityHidden}" />
        </Style>
        <Style Selector="ToggleButton.layerVisibility:checked > Image">
            <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityVisible}" />
        </Style>
        <Style Selector="TabStrip.layerTabs > TabStripItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBlock.overviewLayerName">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TreeView.actorOutliner">
            <Setter Property="Background" Value="{DynamicResource Editor.BackgroundBrush}" />
        </Style>
        <Style Selector="TreeView.actorOutliner TreeViewItem">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="TreeView.mapList TreeViewItem">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />

        <Grid x:Name="MainLayoutGrid" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="320" />
                <RowDefinition Height="4" />
                <RowDefinition Height="240" MinHeight="160" />
            </Grid.RowDefinitions>

            <Grid x:Name="UpperGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="640" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="32,*,24" IsEnabled="{Binding CanEdit}">
                    <TextBlock Grid.Row="0"
                               Classes="panelTitle"
                               Text="{Binding MapList}" />
                    <TreeView x:Name="MapList"
                              Classes="mapList"
                              Grid.Row="1"
                              ItemsSource="{Binding MapWorkspace.Maps}"
                              SelectedItem="{Binding MapWorkspace.SelectedMap}"
                              DoubleTapped="onMapListDoubleTapped"
                              KeyDown="onMapListKeyDown">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:MapListItemViewModel"
                                              ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="18,*,Auto">
                                    <Image Grid.Column="0" Width="16" Height="16"
                                           Source="{StaticResource EditorImage.World}"
                                           IsVisible="{Binding IsWorld}"
                                           VerticalAlignment="Center" />
                                    <Image Grid.Column="0" Width="16" Height="16"
                                           Source="{StaticResource EditorImage.Map}"
                                           IsVisible="{Binding IsMap}"
                                           VerticalAlignment="Center" />
                                    <utils:HintedTextPresenter Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               ToolTip.Tip="{Binding Key}" />
                                    <TextBlock Grid.Column="2" Text="*" IsVisible="{Binding IsModified}" Margin="4,0" VerticalAlignment="Center" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Border Grid.Row="2"
                            Background="Transparent"
                            IsEnabled="{Binding #MapList.IsEnabled}"
                            PointerPressed="onMapListPointerPressed" />
                </Grid>

                <GridSplitter x:Name="UpperLeftSplitter" Grid.Column="1" ResizeDirection="Columns" />

                <Grid x:Name="CenterArea" Grid.Column="2" RowDefinitions="Auto,*">
                    <Grid x:Name="MapEditToolbar"
                          Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          Background="{DynamicResource Editor.SurfaceBrush}">
                        <ScrollViewer x:Name="LayerTabsScroll" Grid.Column="0"
                                      Classes="no-auto-hide"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <TabStrip x:Name="LayerTabs"
                                      Classes="layerTabs"
                                      Height="{DynamicResource Editor.TabHeight}"
                                      MinWidth="120"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding MapWorkspace.LayerTabs}"
                                      SelectedItem="{Binding MapWorkspace.SelectedLayerTab, Mode=TwoWay}">
                                <TabStrip.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerTabViewModel">
                                        <Grid ColumnDefinitions="*,Auto"
                                              HorizontalAlignment="Stretch">
                                            <TextBlock Grid.Column="0"
                                                       Classes.overviewLayerName="{Binding IsOverview}"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <ToggleButton Grid.Column="1"
                                                          Classes="toolbar layerVisibility"
                                                          Width="28"
                                                          Height="28"
                                                          Margin="8,0,0,0"
                                                          Padding="0"
                                                          VerticalAlignment="Center"
                                                          Focusable="False"
                                                          IsVisible="{Binding ShowLayerActions}"
                                                          IsChecked="{Binding LayerVisible, Mode=OneWay}"
                                                          ToolTip.Tip="{Binding VisibilityTooltip}"
                                                          Click="onLayerVisibilityClick">
                                                <Image Width="16"
                                                       Height="16" />
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </TabStrip.ItemTemplate>
                            </TabStrip>
                        </ScrollViewer>

                        <ToggleButton x:Name="LightActorSelectionToggle"
                                      Grid.Column="1"
                                      Height="28"
                                      IsVisible="False"
                                      IsChecked="False"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Click="onLightActorSelectionClick" />

                        <StackPanel x:Name="RunButtons"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <Button x:Name="ConstructButton" Classes="toolbar" IsVisible="False" Click="onConstructClick">
                                <Image Width="16" Height="16" Source="{StaticResource EditorImage.Construct}" />
                            </Button>
                            <Button x:Name="ExportButton" Classes="toolbar" Click="onExportClick">
                                <Image Width="16" Height="16" Source="{StaticResource EditorImage.Export}" />
                            </Button>
                            <Border x:Name="PlayButtonHint" Background="Transparent">
                                <Button x:Name="PlayButton" Classes="toolbar" Click="onPlayClick">
                                    <Image x:Name="PlayIcon" Width="16" Height="16" Source="{StaticResource EditorImage.Play}" />
                                </Button>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                        <Grid x:Name="EditModeToggles"
                              Grid.Column="0"
                              RowDefinitions="48,48,48"
                              Width="48"
                              VerticalAlignment="Top">
                            <ToggleButton x:Name="TileModeToggle" Grid.Row="0" Classes="mode" IsChecked="True" Click="onTileModeClick">
                                <Grid RowDefinitions="28,16">
                                    <Image Grid.Row="0" Width="16" Height="16" Source="{StaticResource EditorImage.ModeTile}" />
                                    <TextBlock Grid.Row="1" Text="{OnPlatform Default=Ctrl+1, macOS=⌘1}" FontSize="12" Foreground="{DynamicResource Editor.TextMutedBrush}" HorizontalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="LightModeToggle" Grid.Row="1" Classes="mode" Click="onLightModeClick">
                                <Grid RowDefinitions="28,16">
                                    <Image Grid.Row="0" Width="16" Height="16" Source="{StaticResource EditorImage.ModeLight}" />
                                    <TextBlock Grid.Row="1" Text="{OnPlatform Default=Ctrl+2, macOS=⌘2}" FontSize="12" Foreground="{DynamicResource Editor.TextMutedBrush}" HorizontalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="ActorModeToggle" Grid.Row="2" Classes="mode" Click="onActorModeClick">
                                <Grid RowDefinitions="28,16">
                                    <Image Grid.Row="0" Width="16" Height="16" Source="{StaticResource EditorImage.ModeActor}" />
                                    <TextBlock Grid.Row="1" Text="{OnPlatform Default=Ctrl+3, macOS=⌘3}" FontSize="12" Foreground="{DynamicResource Editor.TextMutedBrush}" HorizontalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                        </Grid>
                        <ScrollViewer x:Name="EditorScroll"
                                      Grid.Column="1"
                                      MinWidth="576"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <controls:MapPanel x:Name="EditorPanel" />
                        </ScrollViewer>
                        <controls:WorldMapPanel x:Name="WorldEditorPanel"
                                                Grid.Column="1"
                                                IsVisible="False" />
                        <Border x:Name="LiveDebugBanner" Grid.Column="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource Editor.OverlayBrush}" CornerRadius="4" Padding="10,6" Margin="8"
                                IsVisible="False" IsHitTestVisible="False">
                            <TextBlock x:Name="LiveDebugStatus" Foreground="{DynamicResource Editor.TextMutedBrush}" />
                        </Border>
                        <Border x:Name="GameViewport"
                                Grid.Column="1"
                                Background="{DynamicResource Editor.BackgroundBrush}"
                                IsVisible="False">
                            <controls:AspectRatioPanel x:Name="GameAspectPanel">
                                <controls:GamePanel x:Name="GamePanel" />
                            </controls:AspectRatioPanel>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

            <GridSplitter x:Name="UpperLowerSplitter" Grid.Row="1" ResizeDirection="Rows" />

            <Grid x:Name="LowerGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="180" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="32,*">
                    <TextBlock Grid.Row="0"
                               Classes="panelTitle"
                               Text="{Binding ActorLibrary}" />
                    <controls:ActorQueuePanel Grid.Row="1"
                                              Classes="surface"
                                              DataContext="{Binding ActorQueue}" />
                </Grid>

                <GridSplitter x:Name="LowerLeftSplitter" Grid.Column="1" ResizeDirection="Columns" />

                <TabControl x:Name="BottomTabs" Grid.Column="2">
                    <TabItem Header="{Binding FileExplorer}">
                        <controls:FileExplorerPanel x:Name="FileExplorerPanel"
                                                    Classes="surface"
                                                    DataContext="{Binding FileExplorerPanel}" />
                    </TabItem>
                    <TabItem Header="{Binding Console}">
                        <Border x:Name="ConsolePanel" Classes="surface">
                            <Grid RowDefinitions="*,Auto">
                                <Border Grid.Row="0" Background="{DynamicResource Editor.BackgroundBrush}">
                                    <avaloniaEdit:TextEditor x:Name="ConsoleOutput"
                                                             IsReadOnly="True"
                                                             WordWrap="False"
                                                             ShowLineNumbers="False"
                                                             Background="{DynamicResource Editor.BackgroundBrush}"
                                                             Foreground="{DynamicResource Editor.TextBrush}"
                                                             FontFamily="Cascadia Mono,Menlo,Monaco,Consolas"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollBarVisibility="Auto" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{DynamicResource Editor.BackgroundBrush}"
                                        BorderBrush="{DynamicResource Editor.BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="ConsoleInput"
                                                 Grid.Column="0"
                                                 FontFamily="Cascadia Mono,Menlo,Monaco,Consolas"
                                                 IsEnabled="False" />
                                        <Button x:Name="ConsoleSendButton"
                                                Grid.Column="1"
                                                MinWidth="88"
                                                Margin="8,0,0,0"
                                                IsEnabled="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter x:Name="UpperRightSplitter"
                          Grid.Column="1"
                          Grid.RowSpan="3"
                          ResizeDirection="Columns" />

            <Grid x:Name="RightModePanel"
                  Grid.Column="2"
                  Grid.RowSpan="3"
                  MinWidth="320">
                <views:TileSelectPanel x:Name="RightList"
                                       DataContext="{Binding TileSelect}" />
                <controls:LightInfoPanel x:Name="LightInfoPanel"
                                         IsVisible="False" />
                <Grid x:Name="ActorModePanel"
                      RowDefinitions="*,4,2*"
                      IsVisible="False">
                    <Grid x:Name="ActorOutlinerPanel" Grid.Row="0" RowDefinitions="32,*">
                        <TextBlock Grid.Row="0"
                                   Classes="panelTitle"
                                   Text="{Binding WorldOutliner}" />
                        <TreeView x:Name="ActorOutliner"
                                  Grid.Row="1"
                                  Classes="actorOutliner"
                                  ItemsSource="{Binding MapWorkspace.ActorOutlinerItems}"
                                  SelectionChanged="onActorOutlinerSelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:ActorOutlinerItemViewModel"
                                                  ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Description}" />
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                    <GridSplitter x:Name="ActorOutlinerSplitter" Grid.Row="1"
                                  ResizeDirection="Rows" />
                    <controls:ActorInfoPanel x:Name="ActorInfoPanel"
                                             Grid.Row="2" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
