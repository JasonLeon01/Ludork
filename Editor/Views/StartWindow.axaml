<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ludork.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="520"
        x:Class="Ludork.Views.StartWindow"
        x:DataType="vm:StartViewModel"
        Width="820"
        Height="520"
        MinWidth="820"
        MaxWidth="820"
        MinHeight="520"
        MaxHeight="520"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Editor.BackgroundBrush}"
        DragDrop.AllowDrop="True"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico"
        Title="Ludork">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{Binding Plugins}">
                <NativeMenu>
                    <NativeMenuItem Header="{Binding ImportPlugin}" Click="onImportPlugin" />
                    <NativeMenuItem Header="{Binding ManagePlugins}" Click="onManagePlugins" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <Style Selector="Button.startAction">
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.startAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
        </Style>
        <Style Selector="Button.startAction:pressed">
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
        </Style>
        <Style Selector="Button.startAction.primary">
            <Setter Property="Background" Value="{DynamicResource Editor.AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
        </Style>
        <Style Selector="Button.startAction.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Editor.AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.startAction.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource Editor.AccentPressedBrush}" />
        </Style>
        <Style Selector="Button.recentProject">
            <Setter Property="MinHeight" Value="55" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Editor.TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.recentProject:pointerover">
            <Setter Property="Background" Value="{DynamicResource Editor.SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Editor.BorderBrush}" />
        </Style>
        <Style Selector="Button.recentProject:pressed">
            <Setter Property="Background" Value="{DynamicResource Editor.HoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,58,*">
        <NativeMenuBar Grid.Row="0"
                       HorizontalAlignment="Stretch"
                       MaxHeight="64" />

        <Border Grid.Row="1"
                Background="{DynamicResource Editor.SurfaceBrush}"
                BorderBrush="{DynamicResource Editor.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0"
                PointerPressed="onTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Image Width="44" Height="44"
                       VerticalAlignment="Center"
                       Source="/Editor/Assets/icon.png"
                       Stretch="Uniform" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding AppName}"
                           Foreground="{DynamicResource Editor.TextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="34,30,34,28"
              ColumnDefinitions="*,270"
              ColumnSpacing="30">
            <StackPanel MaxWidth="480"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="0">
                <TextBlock Text="{Binding StartTitle}"
                           Foreground="{DynamicResource Editor.TextBrush}"
                           FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,25"
                           Text="{Binding StartSubtitle}"
                           Foreground="{DynamicResource Editor.TextMutedBrush}"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                    <Button Classes="startAction primary accent"
                            Click="onNewProject">
                        <Grid RowDefinitions="Auto,*">
                            <Viewbox Width="30" Height="30"
                                     HorizontalAlignment="Left">
                                <Canvas Width="32" Height="32">
                                    <Path Data="{StaticResource EditorIcon.NewProjectOutline}"
                                          Stroke="{DynamicResource Editor.TextOnAccentBrush}"
                                          StrokeThickness="2" />
                                    <Path Data="{StaticResource EditorIcon.NewProjectEdges}"
                                          Stroke="{DynamicResource Editor.TextOnAccentBrush}"
                                          StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding NewProject}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Viewbox Grid.Column="1" Width="16" Height="16">
                                    <Path Data="{StaticResource EditorIcon.StartArrowRight}"
                                          Stroke="{DynamicResource Editor.TextOnAccentBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round" />
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1"
                            Classes="startAction"
                            Click="onOpenProject">
                        <Grid RowDefinitions="Auto,*">
                            <Image Width="30" Height="30"
                                   HorizontalAlignment="Left"
                                   Source="{StaticResource EditorImage.FolderOpen}"
                                   Stretch="Uniform" />
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding OpenProject}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Viewbox Grid.Column="1" Width="16" Height="16">
                                    <Path Data="{StaticResource EditorIcon.StartArrowRight}"
                                          Stroke="{DynamicResource Editor.TextMutedBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round" />
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="0">
                <TextBlock Margin="0,0,0,7"
                           Text="{Binding RecentProjectsTitle}"
                           Foreground="{DynamicResource Editor.TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding RecentProjects}"
                              IsVisible="{Binding HasRecentProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentProjectViewModel">
                            <Button Classes="recentProject"
                                    Click="onRecentProject"
                                    ToolTip.Tip="{Binding ProjectDirectory}">
                                <Grid ColumnDefinitions="30,*,16"
                                      ColumnSpacing="9">
                                    <Border Width="30" Height="30"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Editor.AccentMutedBrush}"
                                            CornerRadius="4">
                                        <Viewbox Width="17" Height="17">
                                            <Path Data="{StaticResource EditorIcon.StartRecentFolder}"
                                                  Stroke="{DynamicResource Editor.AccentBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeJoin="Round" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource Editor.TextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProjectDirectory}"
                                                   Foreground="{DynamicResource Editor.TextMutedBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Viewbox Grid.Column="2"
                                             Width="15" Height="15"
                                             VerticalAlignment="Center">
                                        <Path Data="{StaticResource EditorIcon.StartArrowRight}"
                                              Stroke="{DynamicResource Editor.TextMutedBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round" />
                                    </Viewbox>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border MinHeight="112"
                        IsVisible="{Binding HasNoRecentProjects}"
                        Background="{DynamicResource Editor.BackgroundBrush}"
                        BorderBrush="{DynamicResource Editor.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding NoRecentProjects}"
                               Foreground="{DynamicResource Editor.TextMutedBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
                <Border Margin="0,14,0,0"
                        BorderBrush="{DynamicResource Editor.BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,12,10,0">
                    <Grid ColumnDefinitions="15,*" ColumnSpacing="8">
                        <Viewbox Width="15" Height="15"
                                 VerticalAlignment="Center">
                            <Path Data="{StaticResource EditorIcon.StartFileUpload}"
                                  Stroke="{DynamicResource Editor.TextMutedBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding DropProjectHint}"
                                   Foreground="{DynamicResource Editor.TextMutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
