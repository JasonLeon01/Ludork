<Window
    x:Class="Ludork.Views.UiAssetEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:Ludork.Views.Utils">
    <Grid RowDefinitions="36,*,28">
        <Border Grid.Row="0" Classes="editor-panel-header" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ResetViewButton" Click="onResetView" />
                <Button x:Name="ValidateButton" Click="onValidate" />
                <Button x:Name="RefreshPreviewButton" Click="onRefreshPreview" />
            </StackPanel>
        </Border>

        <Grid
            x:Name="EditorLayout"
            Grid.Row="1"
            Margin="6"
            ColumnDefinitions="300,6,*,6,420">
            <Grid x:Name="PaletteLayout" Grid.Column="0" RowDefinitions="*,6,*">
                <Border Classes="editor-panel">
                    <Grid RowDefinitions="32,Auto,*">
                        <Border Grid.Row="0" Classes="editor-panel-header">
                            <TextBlock
                                x:Name="PaletteTitle"
                                Classes="panelTitle" />
                        </Border>
                        <TextBox
                            x:Name="PaletteSearch"
                            Grid.Row="1"
                            Margin="8,8,8,6"
                            TextChanged="onPaletteSearchChanged" />
                        <ScrollViewer Grid.Row="2" Padding="8,0,8,8">
                            <StackPanel x:Name="PaletteCategories" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>
                <GridSplitter
                    x:Name="PaletteSplitter"
                    Grid.Row="1"
                    Classes="gutter"
                    ResizeDirection="Rows" />
                <Border
                    Grid.Row="2"
                    Classes="editor-panel">
                    <Grid RowDefinitions="32,*">
                        <Border Grid.Row="0" Classes="editor-panel-header">
                            <TextBlock
                                x:Name="HierarchyTitle"
                                Classes="panelTitle" />
                        </Border>
                        <TreeView
                            x:Name="HierarchyTree"
                            Grid.Row="1"
                            Padding="4"
                            SelectionChanged="onHierarchySelectionChanged"
                            DoubleTapped="onHierarchyDoubleTapped">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-inside">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-before">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-after">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-inside /template/ Border#TreeViewItemLayoutRoot">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-before /template/ Border#TreeViewItemLayoutRoot">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                                    </Style>
                                    <Style Selector="TreeViewItem.drop-after /template/ Border#TreeViewItemLayoutRoot">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Editor.AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility">
                                        <Setter Property="Width" Value="28" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility > Image">
                                        <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityHidden}" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked > Image">
                                        <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityVisible}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate
                                        DataType="utils:UiHierarchyItem"
                                        ItemsSource="{Binding Children}">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6">
                                            <StackPanel
                                                ClipToBounds="True"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock
                                                    Foreground="{DynamicResource Editor.TextMutedBrush}"
                                                    Text="{Binding ControlLabel}" />
                                            </StackPanel>
                                            <ToggleButton
                                                Grid.Column="1"
                                                Classes="toolbar hierarchy-visibility"
                                                IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                IsEnabled="{Binding CanEditVisibility}"
                                                ToolTip.Tip="{Binding VisibilityLabel}"
                                                Click="onHierarchyVisibilityClicked">
                                                <Image
                                                    Width="16"
                                                    Height="16" />
                                            </ToggleButton>
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
            </Grid>
            <GridSplitter x:Name="PaletteColumnSplitter" Grid.Column="1" Classes="gutter" ResizeDirection="Columns" />

            <Grid x:Name="PreviewLayout" Grid.Column="2" RowDefinitions="0,*,6,Auto">
                <Border Grid.Row="1" Classes="editor-panel">
                    <Grid RowDefinitions="32,*">
                        <Border
                            Grid.Row="0"
                            Classes="editor-panel-header"
                            Padding="10,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Name="DesignerTitle"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="ZoomText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Editor.TextMutedBrush}" />
                            </Grid>
                        </Border>
                        <ContentControl x:Name="PreviewContainer" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                </Border>
                <GridSplitter
                    x:Name="TimelineSplitter"
                    Grid.Row="2"
                    Classes="gutter"
                    ResizeDirection="Rows" />
                <Border Grid.Row="3" Classes="editor-panel">
                    <Expander
                        x:Name="TimelineExpander"
                        Classes="timeline-expander"
                        BorderThickness="0"
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="True">
                        <Expander.Header>
                            <Grid Margin="4,2" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Name="TimelineTitle"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </Expander.Header>
                        <Border
                            Height="230"
                            BorderBrush="{DynamicResource Editor.BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                            <ContentControl x:Name="TimelineContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </Border>
                    </Expander>
                </Border>
            </Grid>
            <GridSplitter x:Name="DetailsColumnSplitter" Grid.Column="3" Classes="gutter" ResizeDirection="Columns" />

            <Border
                Grid.Column="4"
                Classes="editor-panel">
                <Grid x:Name="DetailsContainer" RowDefinitions="32,Auto,*">
                    <Border Grid.Row="0" Classes="editor-panel-header">
                        <TextBlock
                            x:Name="DetailsTitle"
                            Classes="panelTitle" />
                    </Border>
                    <Border
                        x:Name="NodeDetailsHeader"
                        Grid.Row="1"
                        Margin="10,10,10,0"
                        Padding="0,0,0,12"
                        BorderBrush="{DynamicResource Editor.BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        IsVisible="False">
                        <StackPanel x:Name="NodeDetailsPanel" Spacing="8" />
                    </Border>
                    <ScrollViewer Grid.Row="2" Padding="10,8,10,10">
                        <StackPanel
                            x:Name="DetailsPanel"
                            Margin="0,0,4,12"
                            Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Classes="editor-panel-footer"
            Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PreviewStateText"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Editor.TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
