<Window
    x:Class="Ludork.Views.UiAssetEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:Ludork.Views.Utils"
    Width="1480"
    Height="860"
    MinWidth="1080"
    MinHeight="640"
    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="36,*,30">
        <Border Grid.Row="0" Background="{DynamicResource Editor.SurfaceBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ResetViewButton" Click="onResetView" />
                <Button x:Name="ValidateButton" Click="onValidate" />
                <Button x:Name="RefreshPreviewButton" Click="onRefreshPreview" />
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="300,4,*,4,420">
            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource Editor.BorderBrush}"
                BorderThickness="0">
                <Grid RowDefinitions="*,4,*">
                    <Border Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock
                                x:Name="PaletteTitle"
                                Margin="4,0,4,8"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <TextBox
                                x:Name="PaletteSearch"
                                Grid.Row="1"
                                Margin="0,0,0,8"
                                TextChanged="onPaletteSearchChanged" />
                            <ScrollViewer Grid.Row="2">
                                <StackPanel x:Name="PaletteCategories" Spacing="4" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <GridSplitter
                        Grid.Row="1"
                        ResizeDirection="Rows" />
                    <Border
                        Grid.Row="2"
                        Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock
                                x:Name="HierarchyTitle"
                                Margin="4,0,4,8"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <TreeView
                                x:Name="HierarchyTree"
                                Grid.Row="1"
                                SelectionChanged="onHierarchySelectionChanged"
                                DoubleTapped="onHierarchyDoubleTapped">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility">
                                        <Setter Property="Width" Value="28" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility > Image">
                                        <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityHidden}" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked > Image">
                                        <Setter Property="Source" Value="{StaticResource EditorImage.VisibilityVisible}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate
                                        DataType="utils:UiHierarchyItem"
                                        ItemsSource="{Binding Children}">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6">
                                            <StackPanel
                                                ClipToBounds="True"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock
                                                    Foreground="{DynamicResource Editor.TextMutedBrush}"
                                                    Text="{Binding ControlLabel}" />
                                            </StackPanel>
                                            <ToggleButton
                                                Grid.Column="1"
                                                Classes="toolbar hierarchy-visibility"
                                                IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                IsEnabled="{Binding CanEditVisibility}"
                                                ToolTip.Tip="{Binding VisibilityLabel}"
                                                Click="onHierarchyVisibilityClicked">
                                                <Image
                                                    Width="16"
                                                    Height="16" />
                                            </ToggleButton>
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*,5,Auto">
                <Border
                    Padding="10,6"
                    Background="{DynamicResource Editor.SurfaceBrush}"
                    BorderBrush="{DynamicResource Editor.BorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="DesignerTitle"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ZoomText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Editor.TextMutedBrush}" />
                    </Grid>
                </Border>
                <ContentControl x:Name="PreviewContainer" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <GridSplitter
                    Grid.Row="2"
                    ResizeDirection="Rows" />
                <Expander
                    x:Name="TimelineExpander"
                    Grid.Row="3"
                    Classes="timeline-expander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="8,4" ColumnDefinitions="*,Auto">
                            <TextBlock
                                x:Name="TimelineTitle"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </Grid>
                    </Expander.Header>
                    <Border
                        Height="230"
                        BorderBrush="{DynamicResource Editor.BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <ContentControl x:Name="TimelineContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Border>
                </Expander>
            </Grid>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

            <Border
                Grid.Column="4"
                Padding="10"
                BorderBrush="{DynamicResource Editor.BorderBrush}"
                BorderThickness="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        x:Name="DetailsTitle"
                        Margin="2,0,2,8"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <StackPanel
                            x:Name="DetailsPanel"
                            Margin="0,0,4,12"
                            Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="10,4"
            Background="{DynamicResource Editor.SurfaceBrush}"
            BorderBrush="{DynamicResource Editor.BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    x:Name="StatusText"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PreviewStateText"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Foreground="{DynamicResource Editor.TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
