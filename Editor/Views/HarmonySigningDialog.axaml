<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.HarmonySigningDialog"
        Width="620"
        SizeToContent="Height"
        MaxHeight="850"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid Margin="24" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SigningPanel" Spacing="14">
                <TextBlock x:Name="DescriptionText"
                           Foreground="{DynamicResource Editor.TextMutedBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Spacing="6">
                    <TextBlock x:Name="KeystoreLabel" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="KeystorePathBox" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                MinWidth="92"
                                Click="onBrowse" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="CertificateLabel" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="CertificatePathBox" />
                        <Button x:Name="CertificateBrowseButton"
                                Grid.Column="1"
                                MinWidth="92"
                                Click="onBrowseCertificate" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ProfileLabel" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ProfilePathBox" />
                        <Button x:Name="ProfileBrowseButton"
                                Grid.Column="1"
                                MinWidth="92"
                                Click="onBrowseProfile" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="KeyAliasLabel" />
                    <TextBox x:Name="KeyAliasBox" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="KeystorePasswordLabel" />
                    <TextBox x:Name="KeystorePasswordBox"
                             PasswordChar="●" />
                </StackPanel>
                <CheckBox x:Name="SameKeyPasswordOption"
                          IsChecked="True" />
                <StackPanel x:Name="KeyPasswordPanel"
                            IsVisible="False"
                            Spacing="6">
                    <TextBlock x:Name="KeyPasswordLabel" />
                    <TextBox x:Name="KeyPasswordBox"
                             PasswordChar="●" />
                </StackPanel>
                <CheckBox x:Name="SaveSigningOption"
                          IsChecked="False"
                          IsVisible="False" />
                <TextBlock x:Name="CredentialStatusText"
                           Foreground="{DynamicResource Editor.WarningBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ValidationText"
                           MinHeight="18"
                           Foreground="{DynamicResource Editor.ErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="ConfirmButton" Click="onConfirm" />
            <Button x:Name="CancelButton" Click="onCancel" />
        </StackPanel>
    </Grid>
</Window>
