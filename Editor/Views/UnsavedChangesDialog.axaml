<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.UnsavedChangesDialog"
        Width="520"
        Height="370"
        CanResize="True"
        MinWidth="420"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="16" />
        <ListBox x:Name="DocumentList" Grid.Row="1" Margin="0,16" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="SaveButton" Click="onSave" />
            <Button x:Name="DiscardButton" Click="onDiscard" />
            <Button x:Name="CancelButton" Click="onCancel" />
        </StackPanel>
    </Grid>
</Window>
