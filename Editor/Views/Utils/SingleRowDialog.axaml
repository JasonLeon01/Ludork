<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.Utils.SingleRowDialog"
        Width="440"
        MinHeight="170"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid RowDefinitions="*,Auto">
        <Grid Margin="24,20,24,14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <TextBox x:Name="ValueBox" Grid.Row="1" />
            <TextBlock x:Name="ErrorText"
                       Grid.Row="2"
                       MinHeight="18"
                       Foreground="{DynamicResource Editor.ErrorBrush}"
                       TextWrapping="Wrap" />
        </Grid>
        <Border Grid.Row="1" Classes="editor-panel-footer" Padding="20,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="CancelButton" Classes="dialog" Click="onCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Classes="dialog accent" Click="onConfirm" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
