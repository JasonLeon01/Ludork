<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Ludork.Controls"
        x:Class="Ludork.Views.AboutDialog"
        Width="760"
        Height="600"
        MinWidth="540"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Editor.BackgroundBrush}"
        FontFamily="{DynamicResource Editor.FontFamily}"
        Icon="/Editor/Assets/icon.ico">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
        <TextBlock x:Name="AppNameText"
                   HorizontalAlignment="Center"
                   FontSize="28"
                   FontWeight="Bold" />
        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   HorizontalAlignment="Center" />
        <controls:DocumentationView x:Name="Documentation" Grid.Row="2" />
        <TextBlock x:Name="CopyrightText"
                   Grid.Row="3"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Editor.TextMutedBrush}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="LicensesButton" Click="onOpenLicenses" />
            <Button x:Name="CloseButton" Click="onClose" />
        </StackPanel>
    </Grid>
</Window>
