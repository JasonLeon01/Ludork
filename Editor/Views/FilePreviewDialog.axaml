<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.FilePreviewDialog"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Editor/Assets/icon.ico">
    <Border Padding="12" Background="{DynamicResource Editor.BackgroundBrush}">
        <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <TextBlock x:Name="PreviewStatus"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Editor.TextMutedBrush}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>