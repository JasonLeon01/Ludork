<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ludork.Views.AndroidSigningInputs">
    <StackPanel x:Name="SigningPanel" Spacing="14">
        <TextBlock x:Name="DescriptionText"
                   Foreground="{DynamicResource Editor.TextMutedBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Spacing="6">
            <TextBlock x:Name="KeystoreLabel" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="KeystorePathBox" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        MinWidth="92"
                        Click="onBrowse" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock x:Name="KeyAliasLabel" />
            <TextBox x:Name="KeyAliasBox" />
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock x:Name="KeystorePasswordLabel" />
            <TextBox x:Name="KeystorePasswordBox"
                     PasswordChar="●" />
        </StackPanel>
        <CheckBox x:Name="SameKeyPasswordOption"
                  IsChecked="True" />
        <StackPanel x:Name="KeyPasswordPanel"
                    IsVisible="False"
                    Spacing="6">
            <TextBlock x:Name="KeyPasswordLabel" />
            <TextBox x:Name="KeyPasswordBox"
                     PasswordChar="●" />
        </StackPanel>
        <CheckBox x:Name="SaveSigningOption"
                  IsChecked="False"
                  IsVisible="False" />
        <TextBlock x:Name="CredentialStatusText"
                   Foreground="{DynamicResource Editor.WarningBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ValidationText"
                   MinHeight="18"
                   Foreground="{DynamicResource Editor.ErrorBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
