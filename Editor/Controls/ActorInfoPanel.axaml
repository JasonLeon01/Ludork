<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Ludork.Controls"
             x:Class="Ludork.Controls.ActorInfoPanel"
             FontSize="12">
    <Border Classes="editor-panel">
        <Grid RowDefinitions="32,*">
            <Border x:Name="TitleContainer" Classes="editor-panel-header">
                <TextBlock x:Name="TitleLabel" Classes="panelTitle" />
            </Border>
            <ScrollViewer x:Name="ScrollArea" Grid.Row="1" Margin="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailContent" Spacing="6">
                    <Grid ColumnDefinitions="78,*" ColumnSpacing="8">
                        <TextBlock x:Name="TagLabel" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="TagEdit" Grid.Column="1" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="78,*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock x:Name="BlueprintLabel" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="BlueprintPath" Grid.Column="1" HorizontalAlignment="Stretch" />
                        <Button x:Name="BlueprintOpenButton" Grid.Column="2" Height="28" Padding="8,0" />
                        <Button x:Name="BlueprintLocateButton" Grid.Column="3" Height="28" Padding="8,0" />
                    </Grid>
                    <Grid ColumnDefinitions="78,*" ColumnSpacing="8">
                        <TextBlock x:Name="PositionLabel" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                            <TextBlock Text="X" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="PositionX" Grid.Column="1" Value="0" Minimum="0" Maximum="0" Increment="1" />
                            <TextBlock Grid.Column="2" Text="Y" Foreground="{DynamicResource Editor.TextMutedBrush}" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="PositionY" Grid.Column="3" Value="0" Minimum="0" Maximum="0" Increment="1" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="LayerReadOnlyLabel" Foreground="{DynamicResource Editor.WarningBrush}" TextWrapping="Wrap" IsVisible="False" />
                    <Border x:Name="ClassSeparator" Height="1" Margin="0,4" Background="{DynamicResource Editor.BorderSubtleBrush}" />
                    <Grid x:Name="ClassTitleContainer" ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBlock x:Name="ClassTitleLabel" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ResetAllButton" Grid.Column="1" Height="28" Padding="8,0" HorizontalAlignment="Right" />
                    </Grid>
                    <controls:BlueprintVariableForm x:Name="ClassForm" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="NoSelectionLabel" Grid.Row="1" FontStyle="Italic"
                       HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" />
        </Grid>
    </Border>
</UserControl>
