{
  "id": "tileDeselect",
  "trigger": "map.tilePaintCommitted",
  "anchor": "map.workspace",
  "duration": 3,
  "loop": true,
  "elements": [
    {
      "id": "selectedTile",
      "type": "group",
      "layoutKey": "selectedTile",
      "children": [
        {
          "id": "selectionFill",
          "type": "rectangle",
          "width": { "value": 1 },
          "height": { "value": 1 },
          "fill": "Editor.AccentBrush",
          "opacity": 0.15
        },
        {
          "id": "selectionBorder",
          "type": "rectangle",
          "width": { "value": 1 },
          "height": { "value": 1 },
          "stroke": "Editor.AccentBrush",
          "strokeThickness": 2
        },
        {
          "id": "hand",
          "type": "image",
          "x": { "value": 0.5, "offset": -1.5 },
          "y": { "value": 0.5, "offset": -1.5 },
          "width": { "offset": 48 },
          "height": { "offset": 64 },
          "asset": "hand.svg"
        }
      ]
    },
    {
      "id": "instructions",
      "type": "group",
      "layoutKey": "instructions",
      "children": [
        {
          "id": "instructionsBackground",
          "type": "rectangle",
          "width": { "value": 1 },
          "height": { "value": 1 },
          "fill": "Editor.SurfaceBrush",
          "stroke": "Editor.BorderBrush"
        },
        {
          "id": "deselectDescription",
          "type": "text",
          "x": { "offset": 16 },
          "y": { "offset": 12 },
          "width": { "value": 1, "offset": -32 },
          "height": { "offset": 52 },
          "textKey": "TUTORIAL_TILE_DESELECT_DESCRIPTION",
          "fill": "Editor.TextBrush",
          "fontSize": 16
        },
        {
          "id": "eraseDescription",
          "type": "text",
          "x": { "offset": 16 },
          "y": { "offset": 66 },
          "width": { "value": 1, "offset": -32 },
          "height": { "offset": 60 },
          "textKey": "TUTORIAL_TILE_ERASE_DESCRIPTION",
          "fill": "Editor.TextBrush",
          "fontSize": 16
        },
        {
          "id": "dismissLabel",
          "type": "text",
          "x": { "offset": 16 },
          "y": { "offset": 140 },
          "width": { "value": 1, "offset": -32 },
          "height": { "offset": 26 },
          "textKey": "TUTORIAL_DISMISS",
          "fill": "Editor.TextMutedBrush",
          "fontSize": 14
        }
      ]
    }
  ],
  "tracks": [
    {
      "target": "selectionFill",
      "property": "opacity",
      "keyframes": [
        { "time": 0, "value": 0.15 },
        { "time": 1.1, "value": 0.32, "easing": "smooth" },
        { "time": 2.4, "value": 0.15, "easing": "smooth" },
        { "time": 3, "value": 0.15 }
      ]
    },
    {
      "target": "hand",
      "property": "x",
      "keyframes": [
        { "time": 0.2, "value": 0.5, "offset": 22 },
        { "time": 0.8, "value": 0.5, "offset": -1.5, "easing": "smooth" }
      ]
    },
    {
      "target": "hand",
      "property": "y",
      "keyframes": [
        { "time": 0.2, "value": 0.5, "offset": 30 },
        { "time": 0.8, "value": 0.5, "offset": -1.5, "easing": "smooth" }
      ]
    },
    {
      "target": "hand",
      "property": "scaleX",
      "keyframes": [
        { "time": 0.95, "value": 1 },
        { "time": 1.1, "value": 0.9, "easing": "smooth" },
        { "time": 1.3, "value": 1, "easing": "smooth" }
      ]
    },
    {
      "target": "hand",
      "property": "scaleY",
      "keyframes": [
        { "time": 0.95, "value": 1 },
        { "time": 1.1, "value": 0.9, "easing": "smooth" },
        { "time": 1.3, "value": 1, "easing": "smooth" }
      ]
    },
    {
      "target": "hand",
      "property": "opacity",
      "keyframes": [
        { "time": 0.2, "value": 0 },
        { "time": 0.45, "value": 1 },
        { "time": 2.3, "value": 1 },
        { "time": 2.65, "value": 0 },
        { "time": 3, "value": 0 }
      ]
    }
  ]
}
