{
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/Engine/Runtime/include",
        "${workspaceFolder}/Engine/Source/Core/include",
        "${workspaceFolder}/Engine/Source/Global/include",
        "${workspaceFolder}/Engine/Source/GlobalFunctions/include",
        "${workspaceFolder}/Engine/Standard/include",
        "${workspaceFolder}/Engine/Standard/src",
        "${workspaceFolder}/build/LuaSF/generated_include",
        "${workspaceFolder}/Engine/ThirdParty/LuaSF/include",
        "${workspaceFolder}/Engine/ThirdParty/LuaSF/third_party/sol2/include",
        "${workspaceFolder}/Engine/ThirdParty/LuaSF/third_party/Lua/src",
        "${workspaceFolder}/Engine/ThirdParty/LuaSF/third_party/SFML/include",
        "${workspaceFolder}/Engine/ThirdParty/LuaSF/third_party/SFML/src",
        "${workspaceFolder}/Engine/ThirdParty/zlib",
        "${workspaceFolder}/build/zlib",
        "${workspaceFolder}/build/Engine/cmake/FFmpeg/external/install/include"
    ],
    "C_Cpp.codeAnalysis.exclude": {
        "**/Engine/ThirdParty/**": true,
        "**/Intermediate/**": true,
        "**/ThirdPartySource/**": true
    },
    "Lua.workspace.library": [
        "${workspaceFolder}/Scripts/stub"
    ],
    "Lua.workspace.checkThirdParty": false,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "C_Cpp.clang_format_style": "file",
    "[lua]": {
        "editor.defaultFormatter": "tangzx.emmylua",
        "editor.formatOnSave": true
    }
}
