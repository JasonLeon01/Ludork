<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.TextConfigCreationDialog"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        FontFamily="avares://Ludork/Assets/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC"
        Icon="/Assets/icon.ico">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock x:Name="TypeLabel"
                   Grid.Row="0" />
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="24">
            <RadioButton x:Name="PlainOption"
                         GroupName="TextConfigType"
                         IsChecked="True" />
            <RadioButton x:Name="RichOption"
                         GroupName="TextConfigType" />
        </StackPanel>
        <TextBlock x:Name="PathLabel"
                   Grid.Row="2"
                   Margin="0,8,0,0" />
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <TextBox x:Name="PathBox"
                     Grid.Column="0" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="..."
                    Click="onBrowse" />
        </Grid>
        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="ConfirmButton"
                    Click="onConfirm" />
            <Button x:Name="CancelButton"
                    Click="onCancel" />
        </StackPanel>
    </Grid>
</Window>
