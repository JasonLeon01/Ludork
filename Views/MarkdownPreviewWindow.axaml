<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Ludork.Views"
        x:Class="Ludork.Views.MarkdownPreviewWindow"
        x:CompileBindings="False"
        Width="1080"
        Height="600"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        FontFamily="avares://Ludork/Assets/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC"
        Icon="/Assets/icon.ico">
    <Window.Styles>
        <Style Selector="TextBox.docSearch">
            <Setter Property="Width" Value="220" />
        </Style>
        <Style Selector="TreeView">
            <Setter Property="Background" Value="#1f1f1f" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="TabStrip.documentSections">
            <Setter Property="Background" Value="#1f1f1f" />
        </Style>
        <Style Selector="TabStrip.documentSections > TabStripItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabStrip.documentSections > TabStripItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource LudorkPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LudorkPrimaryBrush}" />
        </Style>
        <Style Selector="TabStrip.documentSections > TabStripItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource LudorkPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LudorkPrimaryBrush}" />
        </Style>
        <Style Selector="Button.markdownHeading">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Styles>
    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,8,*">
        <ScrollViewer x:Name="SectionTabsScrollViewer"
                      Grid.Row="0"
                      Background="#1f1f1f"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <TabStrip x:Name="SectionTabs"
                      Classes="documentSections"
                      HorizontalAlignment="Left"
                      SelectionChanged="onSectionSelectionChanged">
                <TabStrip.ItemTemplate>
                    <DataTemplate DataType="local:MarkdownDocumentSection">
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
        </ScrollViewer>
        <Border x:Name="SectionTabsGap" Grid.Row="1" Height="8" />
        <Grid Grid.Row="2" ColumnDefinitions="Auto,52,*">
            <TextBox x:Name="SearchBox"
                     Classes="docSearch"
                     PlaceholderText="Search"
                     TextChanged="onSearchChanged" />
            <TextBlock x:Name="SearchCountText"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="2*,8,8*">
            <TreeView x:Name="DocumentTree"
                      Grid.Column="0"
                      SelectionChanged="onDocumentSelectionChanged">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="local:MarkdownDocumentEntry" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="18" Foreground="#ffffff" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter x:Name="DocumentTreeSplitter"
                          Grid.Column="1"
                          Width="8"
                          Background="#262626"
                          ResizeDirection="Columns" />
            <ScrollViewer x:Name="DocumentScrollViewer"
                          Grid.Column="2"
                          Background="#1f1f1f"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DocumentPreview" Margin="16" Spacing="6" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
