<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Ludork.Views"
        x:Class="Ludork.Views.MarkdownPreviewWindow"
        x:CompileBindings="False"
        Width="1080"
        Height="600"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        FontFamily="avares://Ludork/Assets/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC"
        Icon="/Assets/icon.ico">
    <Window.Styles>
        <Style Selector="TextBox.docSearch">
            <Setter Property="Width" Value="220" />
        </Style>
        <Style Selector="TreeView">
            <Setter Property="Background" Value="#1f1f1f" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="Button.markdownHeading">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.markdownLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7ec8ff" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.markdownLink:pointerover">
            <Setter Property="Foreground" Value="#b3ddff" />
        </Style>
    </Window.Styles>
    <Grid Margin="8" RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="Auto,52,*">
            <TextBox x:Name="SearchBox"
                     Classes="docSearch"
                     PlaceholderText="Search"
                     TextChanged="onSearchChanged" />
            <TextBlock x:Name="SearchCountText"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="2*,8,8*">
            <TreeView x:Name="DocumentTree"
                      Grid.Column="0"
                      SelectionChanged="onDocumentSelectionChanged">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="local:MarkdownDocumentEntry" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" FontSize="18" Foreground="#ffffff" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="8" Background="#262626" ResizeDirection="Columns" />
            <ScrollViewer x:Name="DocumentScrollViewer"
                          Grid.Column="2"
                          Background="#1f1f1f"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DocumentPreview" Margin="16" Spacing="6" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
