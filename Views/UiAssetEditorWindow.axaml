<Window
    x:Class="Ludork.Views.UiAssetEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:Ludork.Views.Utils"
    Width="1480"
    Height="860"
    MinWidth="1080"
    MinHeight="640"
    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="44,*,30">
        <Border
            Grid.Row="0"
            Padding="10,6"
            Background="#252525"
            BorderBrush="#404040"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock
                    x:Name="DocumentTitle"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold" />
                <Button
                    x:Name="ResetViewButton"
                    Grid.Column="1"
                    MinWidth="84"
                    Margin="4,0"
                    Click="onResetView" />
                <Button
                    x:Name="ValidateButton"
                    Grid.Column="2"
                    MinWidth="84"
                    Margin="4,0"
                    Click="onValidate" />
                <Button
                    x:Name="RefreshPreviewButton"
                    Grid.Column="3"
                    MinWidth="108"
                    Margin="4,0"
                    Click="onRefreshPreview" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="300,5,*,5,420">
            <Border
                Grid.Column="0"
                BorderBrush="#404040"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,5,*">
                    <Border Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock
                                x:Name="PaletteTitle"
                                Margin="4,0,4,8"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <TextBox
                                x:Name="PaletteSearch"
                                Grid.Row="1"
                                Margin="0,0,0,8"
                                TextChanged="onPaletteSearchChanged" />
                            <ScrollViewer Grid.Row="2">
                                <StackPanel x:Name="PaletteCategories" Spacing="4" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <GridSplitter
                        Grid.Row="1"
                        ResizeDirection="Rows" />
                    <Border
                        Grid.Row="2"
                        Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock
                                x:Name="HierarchyTitle"
                                Margin="4,0,4,8"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <TreeView
                                x:Name="HierarchyTree"
                                Grid.Row="1"
                                SelectionChanged="onHierarchySelectionChanged"
                                DoubleTapped="onHierarchyDoubleTapped">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility">
                                        <Setter Property="Width" Value="28" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility > PathIcon">
                                        <Setter Property="Data" Value="{StaticResource EditorIcon.VisibilityHidden}" />
                                    </Style>
                                    <Style Selector="ToggleButton.hierarchy-visibility:checked > PathIcon">
                                        <Setter Property="Data" Value="{StaticResource EditorIcon.VisibilityVisible}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate
                                        DataType="utils:UiHierarchyItem"
                                        ItemsSource="{Binding Children}">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="6">
                                            <StackPanel
                                                ClipToBounds="True"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock
                                                    Foreground="#888888"
                                                    Text="{Binding ControlLabel}" />
                                            </StackPanel>
                                            <ToggleButton
                                                Grid.Column="1"
                                                Classes="hierarchy-visibility"
                                                IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                IsEnabled="{Binding CanEditVisibility}"
                                                ToolTip.Tip="{Binding VisibilityLabel}"
                                                Click="onHierarchyVisibilityClicked">
                                                <PathIcon
                                                    Width="16"
                                                    Height="16" />
                                            </ToggleButton>
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border
                    Padding="10,6"
                    Background="#252525"
                    BorderBrush="#404040"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="DesignerTitle"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ZoomText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="#888888" />
                    </Grid>
                </Border>
                <ContentControl x:Name="PreviewContainer" Grid.Row="1" />
            </Grid>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

            <Border
                Grid.Column="4"
                Padding="10"
                BorderBrush="#404040"
                BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        x:Name="DetailsTitle"
                        Margin="2,0,2,8"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <StackPanel
                            x:Name="DetailsPanel"
                            Margin="0,0,4,12"
                            Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="10,4"
            Background="#252525"
            BorderBrush="#404040"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    x:Name="StatusText"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PreviewStateText"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Foreground="#888888" />
            </Grid>
        </Border>
    </Grid>
</Window>
