<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ludork.Views.AboutDialog"
        Width="500"
        Height="400"
        MinWidth="400"
        MinHeight="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        FontFamily="avares://Ludork/Assets/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC"
        Icon="/Assets/icon.ico">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock x:Name="AppNameText"
                   HorizontalAlignment="Center"
                   FontSize="28"
                   FontWeight="Bold" />
        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="DescriptionText"
                   Grid.Row="2"
                   HorizontalAlignment="Stretch"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="CopyrightText"
                   Grid.Row="3"
                   HorizontalAlignment="Center"
                   Foreground="#9a9a9a" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="LicensesButton" Click="onOpenLicenses" />
            <Button x:Name="CloseButton" Click="onClose" />
        </StackPanel>
    </Grid>
</Window>
