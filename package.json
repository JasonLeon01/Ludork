{
  "name": "ludork-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node tools/start.mjs",
    "server": "node backend/main.ts",
