    "lint": "eslint backend frontend tools"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
